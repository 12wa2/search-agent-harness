# Copy this file to `.env` once. scripts/start-dev.cmd loads it automatically.
# The Web API starts in quick-demo mode by default; fill the gateway keys and
# Hybrid V2 settings below to enable the in-page "full online" switch.

# -- LLM (full online only; the quick demo needs no key) -----------------
SEARCH_AGENT_API_KEY=
SEARCH_AGENT_BASE_URL=https://api.openai.com/v1
SEARCH_AGENT_MODEL=gpt-4o-mini
# Aliases used when the SEARCH_AGENT_* values above are unset:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Qwen reasoning models can spend thousands of tokens on hidden thinking.
# Set to 1 to send enable_thinking=false; use only for providers that support it.
# SEARCH_AGENT_DISABLE_THINKING=1
# Per-call HTTP timeout in seconds (default 60).
# SEARCH_AGENT_LLM_TIMEOUT_SEC=60
# Transient-error retries, JSON repair rounds, and exponential-backoff base.
# SEARCH_AGENT_LLM_RETRIES=2
# SEARCH_AGENT_LLM_JSON_REPAIRS=1
# SEARCH_AGENT_LLM_BACKOFF_SEC=0.5

# -- Optional LLM gateway ------------------------------------------------
# Start the gateway with: search-agent gateway --config gateway.local.json
# The agent then points at the gateway instead of a provider directly.
# SEARCH_AGENT_API_KEY=local-gateway-key
# SEARCH_AGENT_BASE_URL=http://127.0.0.1:4000/v1
# SEARCH_AGENT_MODEL=search-agent-primary
# The gateway's incoming bearer token (read by config.gateway_api_key_env):
# SEARCH_AGENT_GATEWAY_API_KEY=local-gateway-key
# Programmatic GatewayConfig.from_env() loaders read this path; the CLI uses --config.
# SEARCH_AGENT_GATEWAY_CONFIG=./gateway.local.json
# Upstream keys referenced by examples/gateway.example.json. The helper starts
# the gateway only when at least one of these is set. The Web API still starts
# in quick-demo mode; use the page button to switch to full online, or pass
# -StartOnline to start directly in full online mode.
# PRIMARY_LLM_API_KEY=
# FALLBACK_LLM_API_KEY=

# -- Optional Redis (conversation memory / strategy memory) --------------
# Leave empty to use the in-process store. Any Redis-compatible URL works.
# SEARCH_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0

# -- Bundled Elasticsearch demo backend (--backend es) -------------------
# Used by `examples/es_end_to_end.py` and the simple ES backend.
# SEARCH_AGENT_ES_URL=http://127.0.0.1:9200
# SEARCH_AGENT_ES_INDEX=search-agent-demo

# -- Full-online Hybrid V2 backend ---------------------------------------
# The Web console's full-online preset uses the configured online LLM plus
# this retrieval backend. The quick-demo preset always uses the 16-candidate
# in-memory corpus, regardless of these values.
# SEARCH_AGENT_BACKEND=hybrid_v2
# SEARCH_AGENT_HYBRID_V2_ES_URL=http://127.0.0.1:9200
# SEARCH_AGENT_HYBRID_V2_ES_INDEX=candidate
# SEARCH_AGENT_ES_USERNAME=
# SEARCH_AGENT_ES_PASSWORD=
# SEARCH_AGENT_ES_API_KEY=
# SEARCH_AGENT_ES_VERIFY_CERTS=true
# SEARCH_AGENT_ES_REQUEST_TIMEOUT=30

# Field names are configurable for your own index mapping.
# Set a field to empty to disable that filter.
# SEARCH_AGENT_HYBRID_V2_TENANT_FIELD=company_id
# SEARCH_AGENT_HYBRID_V2_ENTITY_JOIN_FIELD=entity_join
# SEARCH_AGENT_HYBRID_V2_ENTITY_JOIN_VALUE=profile
# SEARCH_AGENT_HYBRID_V2_SOFT_DELETE_FIELD=deleted

# `nested` expects work_segments/project_segments/education_segments vectors;
# `flat` expects work_vector/project_vector/education_vector at document level.
# SEARCH_AGENT_HYBRID_V2_VECTOR_MODE=flat
# SEARCH_AGENT_HYBRID_V2_BM25_ENABLED=true
# SEARCH_AGENT_HYBRID_V2_KNN_K=100
# SEARCH_AGENT_HYBRID_V2_KNN_NUM_CANDIDATES=500
# SEARCH_AGENT_HYBRID_V2_CHEAP_POOL_SIZE=100
# SEARCH_AGENT_HYBRID_V2_MATCH_RATE_BASELINE=40

# Embeddings: hash is deterministic and offline; openai supports any
# OpenAI-compatible /embeddings endpoint.
# SEARCH_AGENT_EMBEDDING_PROVIDER=hash
# SEARCH_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# SEARCH_AGENT_EMBEDDING_DIMS=256
# SEARCH_AGENT_EMBEDDING_BATCH_SIZE=16
# SEARCH_AGENT_EMBEDDING_API_KEY=
# SEARCH_AGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Reranking: local is deterministic and needs no key. Set provider to openai
# only when you want bounded LLM shard reranking.
# SEARCH_AGENT_HYBRID_V2_RERANK_PROVIDER=local
# SEARCH_AGENT_HYBRID_V2_RERANK_MODEL=gpt-4o-mini
# SEARCH_AGENT_RERANK_API_KEY=
# SEARCH_AGENT_RERANK_BASE_URL=https://api.openai.com/v1
# SEARCH_AGENT_HYBRID_V2_RERANK_SCAN_CAP=100
# SEARCH_AGENT_HYBRID_V2_RERANK_TARGET_N=20
# SEARCH_AGENT_HYBRID_V2_RERANK_SHARD_SIZE=20
# SEARCH_AGENT_HYBRID_V2_RERANK_MIN_CONFIDENCE=0.5
# SEARCH_AGENT_HYBRID_V2_RERANK_TIMEOUT_SEC=30
# SEARCH_AGENT_HYBRID_V2_RERANK_WORKERS=4

# Optional local catalogs (JSON). No provider API is called by the engine.
# SEARCH_AGENT_HYBRID_V2_TAG_DICT=./data/tag_dict.json
# SEARCH_AGENT_HYBRID_V2_SALARY_BANDS=./data/salary_bands.json
# SEARCH_AGENT_HYBRID_V2_WORK_STATES=./data/work_states.json
# SEARCH_AGENT_HYBRID_V2_ONET_ALIASES=./data/onet_position_aliases.json

# -- Budget knobs (uncomment to override runtime defaults) ---------------
# SEARCH_AGENT_MAX_ITERATIONS=3
# SEARCH_AGENT_MAX_PATHS_PER_ITERATION=4
# target_qualified defaults to max(top_k*2, 20)
# SEARCH_AGENT_TARGET_QUALIFIED=40
# recall_pool_size defaults to max(top_k*3, 30)
# SEARCH_AGENT_RECALL_POOL_SIZE=30
# SEARCH_AGENT_TIME_BUDGET_SEC=12.0
# Real LLM runs often need a larger wall-clock budget than the offline default.
# SEARCH_AGENT_TIME_BUDGET_SEC=180
# SEARCH_AGENT_LLM_CALL_BUDGET=40
# SEARCH_AGENT_TOKEN_BUDGET=0

# -- Container ------------------------------------------------------------
# Read by the Docker image and HEALTHCHECK.
# SEARCH_AGENT_PORT=8000
